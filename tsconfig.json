{
  "compilerOptions": {
    "paths": {
      "@contracts/*": ["./src/contracts/*"],
      "@implementations/*": ["./src/implementations/*"],
      "@errors/*": ["./src/errors/*"],
      "@testsuite/*": ["./src/testsuite/*"],
      "@facades/*": ["./src/facades/*"],
      "@decorators/*": ["./src/decorators/*"],
      "@fakes/*": ["./src/fakes/*"],
    },
    "lib": ["ES6", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "target": "es2017",
    "outDir": "dist",
  },
  "include": [
    "src/**/*",
  ]
}