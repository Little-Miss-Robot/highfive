{
  "name": "@littlemissrobot/interop-core",
  "type": "module",
  "author": "Rein Van Oyen",
  "description": "",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Miss-Robot/interop-core.git"
  },
  "homepage": "https://github.com/Little-Miss-Robot/interop-core#readme",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testsuite": {
      "types": "./dist/testsuite.d.ts",
      "import": "./dist/testsuite.js",
      "require": "./dist/testsuite.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:barrels": "barrelsby --directory src/contracts src/implementations src/decorators src/errors src/facades src/fakes src/testsuite --singleQuotes --noHeader --delete",
    "build": "tsup",
    "demo": "tsx src/demo.ts",
    "test": "vitest run"
  },
  "license": "ISC",
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "barrelsby": "^2.8.1",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  }
}
